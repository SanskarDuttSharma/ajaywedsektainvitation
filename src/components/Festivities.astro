---
import { events } from '../data/events';
---

<section id="festivities" class="festivities-section px-4 relative" style="background: var(--color-cream)">
  <div class="max-w-5xl mx-auto">

    <!-- Section header -->
    <div class="text-center mb-10 md:mb-16 reveal">
      <p class="font-heading text-xs tracking-[0.3em] uppercase mb-3" style="color: var(--color-gold)">Join us for</p>
      <h2 class="font-script festivities-title mb-4" style="color: var(--color-deep)">The Festivities</h2>
      <div class="gold-divider"><span class="text-xl">✦</span></div>
    </div>

    <!-- Event cards grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 md:gap-8">
      {events.map((event, i) => (
        <div
          class="event-card reveal rounded-2xl overflow-hidden shadow-md flex flex-col"
          style={`background: var(--color-ivory); border-top: 4px solid ${event.color};`}
        >
          <!-- Card header -->
          <div class="px-7 pt-7 pb-4">
            <div class="flex items-center gap-3 mb-3">
              <h3 class="font-heading text-xl" style={`color: ${event.color}`}>{event.name}</h3>
            </div>
            <p class="font-body text-sm opacity-70 italic mb-4" style="color: var(--color-deep)">"{event.quote}"</p>
          </div>

          <!-- Details -->
          <div class="px-7 pb-4 flex flex-col gap-2 flex-1">
            <div class="flex items-start gap-3">
              <span class="text-base mt-0.5">📅</span>
              <div>
                <p class="font-heading text-xs tracking-wider uppercase opacity-50" style="color: var(--color-deep)">Date & Time</p>
                <p class="font-body text-sm font-medium" style="color: var(--color-deep)">{event.dateLabel}</p>
                <p class="font-body text-sm" style="color: var(--color-deep)">{event.timeLabel}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-base mt-0.5">📍</span>
              <div>
                <p class="font-heading text-xs tracking-wider uppercase opacity-50" style="color: var(--color-deep)">Venue</p>
                <p class="font-body text-sm font-medium" style="color: var(--color-deep)">{event.venue}</p>
                <p class="font-body text-xs opacity-60" style="color: var(--color-deep)">{event.address}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-base mt-0.5">👗</span>
              <div>
                <p class="font-heading text-xs tracking-wider uppercase opacity-50" style="color: var(--color-deep)">Dress Code</p>
                <p class="font-body text-sm" style="color: var(--color-deep)">{event.dressCode}</p>
              </div>
            </div>
          </div>

          <!-- Actions -->
          <div class="px-7 pb-7 pt-2 flex gap-3 flex-wrap">
            <a
              href={event.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2 rounded-full text-xs font-heading tracking-wider uppercase transition-all hover:scale-105"
              style={`border: 1.5px solid ${event.color}; color: ${event.color}`}
            >
              📍 Directions
            </a>
            <a
              href={`https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(event.name + ' — Ekta & Ajay')}&dates=${event.gcalStart}/${event.gcalEnd}&details=${encodeURIComponent(event.quote)}&location=${encodeURIComponent(event.address)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2 rounded-full text-xs font-heading tracking-wider uppercase transition-all hover:scale-105"
              style={`background: ${event.color}; color: white`}
            >
              📅 Add to Calendar
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .festivities-section {
    padding-top:    clamp(3rem, 8vw, 6rem);
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .festivities-title {
    font-size: clamp(3.2rem, 11vw, 5.5rem);
  }
  /* Tighten card internals on small screens */
  @media (max-width: 480px) {
    .event-card .px-7 { padding-left: 1.25rem; padding-right: 1.25rem; }
    .event-card .pt-7 { padding-top: 1.25rem; }
    .event-card .pb-7 { padding-bottom: 1.25rem; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const revealEls = document.querySelectorAll<HTMLElement>('.reveal');

  // Set initial hidden state via JS so CSS never hides them if JS is unavailable
  gsap.set(revealEls, { opacity: 0, y: 50 });

  revealEls.forEach((el, i) => {
    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: 0.9,
      delay: i * 0.08,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: el,
        start: 'top 88%',
        once: true,
      },
    });
  });
</script>
