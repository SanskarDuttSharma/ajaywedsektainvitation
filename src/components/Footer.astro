---
---

<footer class="footer-section">

  <!-- Gold ornamental divider -->
  <div class="ornament-divider">
    <div class="ornament-line"></div>
    <span class="ornament-diamond">❖</span>
    <div class="ornament-line"></div>
  </div>

  <!-- Closing message -->
  <p class="font-script footer-closing">We can't wait to<br/>celebrate with you!</p>

  <!-- Couple names -->
  <p class="font-script footer-names">Ekta &amp; Ajay</p>

  <!-- Heart divider -->
  <div class="heart-row">
    <div class="heart-line"></div>
    <span class="heart-icon">♥</span>
    <div class="heart-line"></div>
  </div>

  <!-- Special invite credit -->
  <div class="special-invite">
    <p class="font-body invite-label">Special invite from</p>
    <p class="font-heading invite-name">Sanskar Dutt Sharma</p>
  </div>

  <!-- Gold ornamental divider -->
  <div class="ornament-divider">
    <div class="ornament-line"></div>
    <span class="ornament-diamond">❖</span>
    <div class="ornament-line"></div>
  </div>

  <!-- Thank you -->
  <p class="font-script footer-thankyou">Thank you!</p>

  <!-- Hashtag -->
  <p class="font-heading footer-meta">
    20 November 2026 &bull; #EktaAndAjayBecomeEkay
  </p>

</footer>

<style>
  .footer-section {
    background: var(--color-ivory);
    padding: 0 1.5rem clamp(2rem,5vw,3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.9rem,2.5vw,1.5rem);
    border-top: 1px solid rgba(201,168,76,0.15);
    scroll-snap-align: start;
  }

  .ornament-divider {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: min(200px, 55vw);
  }
  .ornament-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(201,168,76,0.5), transparent);
  }
  .ornament-diamond {
    color: var(--color-gold);
    font-size: 0.65rem;
    opacity: 0.8;
  }

  .footer-closing {
    font-size: clamp(2rem,7.5vw,3.4rem);
    color: var(--color-gold);
    line-height: 1.15;
    text-align: center;
  }

  .footer-names {
    font-size: clamp(2.4rem,9vw,4.2rem);
    color: var(--color-deep);
    margin: 0;
    line-height: 1.1;
  }

  .heart-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: min(220px, 60vw);
  }
  .heart-line { flex: 1; height: 1px; background: rgba(201,168,76,0.35); }
  .heart-icon { color: var(--color-gold); font-size: 0.8rem; }

  .special-invite {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }
  .invite-label {
    font-size: clamp(12px,2.8vw,14px);
    color: var(--color-deep);
    opacity: 0.6;
    font-style: italic;
    margin: 0;
  }
  .invite-name {
    font-size: clamp(1rem,4vw,1.4rem);
    color: var(--color-gold);
    letter-spacing: 0.06em;
    margin: 0;
  }

  .footer-thankyou {
    font-size: clamp(2rem,7vw,3rem);
    color: var(--color-gold);
    line-height: 1.1;
  }

  .footer-meta {
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-deep);
    opacity: 0.3;
    text-align: center;
  }
</style>
