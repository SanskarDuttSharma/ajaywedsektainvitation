---
---

<section id="hero" class="hero-section">

  <!-- Background photo -->
  <img class="hero-bg-img" src="/images/HeroPageBackground.jpeg" alt="" aria-hidden="true" />

  <!-- Top fade to blend text area -->
  <div class="hero-top-fade"></div>

  <!-- Corner bracket decorations -->
  <div class="corner corner-tl"></div>
  <div class="corner corner-tr"></div>
  <div class="corner corner-bl"></div>
  <div class="corner corner-br"></div>

  <!-- Centered content -->
  <div class="hero-content">


    <!-- Names -->
    <div class="hero-name-row">
      <h1 class="font-heading hero-name">Ekta</h1>
      <div class="font-heading hero-diamond">And</div>
      <h1 class="font-heading hero-name">Ajay</h1>
    </div>
    <div class="font-heading hero-diamond">Become</div>

    <!-- Divider with dot -->
    <div class="hero-dot-row">
      <div class="dot-line"></div>
      <div class="dot-center"></div>
      <div class="dot-line"></div>
    </div>

    <!-- Invitation sub-text -->
    <p class="font-heading hero-invite">#EKAY</p>

  </div>

  <!-- Scroll indicator -->
  <div class="scroll-cue">
    <span class="font-heading scroll-label">Scroll</span>
    <svg class="scroll-arrow" viewBox="0 0 24 24" fill="none">
      <path d="M12 5v14M6 13l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

</section>

<style>
  .hero-section {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    overflow: hidden;
    background-color: var(--color-ivory);
  }

  /* Background photo — cover fills the full hero, crops edges, never stretches */
  .hero-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    z-index: 0;
    pointer-events: none;
    user-select: none;
  }

  .hero-top-fade {
    display: none;
  }

  @media (max-width: 480px) {
    .hero-content { padding: 3rem 1.25rem 2rem; }
  }

  /* Corner brackets */
  .corner {
    position: absolute;
    width: 36px;
    height: 36px;
    z-index: 3;
    opacity: 0.7;
  }
  .corner-tl { top: 1.5rem; left: 1.5rem;  border-top: 1.5px solid var(--color-gold); border-left:  1.5px solid var(--color-gold); }
  .corner-tr { top: 1.5rem; right: 1.5rem; border-top: 1.5px solid var(--color-gold); border-right: 1.5px solid var(--color-gold); }
  .corner-bl { bottom: 1.5rem; left: 1.5rem;  border-bottom: 1.5px solid var(--color-gold); border-left:  1.5px solid var(--color-gold); }
  .corner-br { bottom: 1.5rem; right: 1.5rem; border-bottom: 1.5px solid var(--color-gold); border-right: 1.5px solid var(--color-gold); }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(3.5rem, 8vh, 6rem) 1.5rem 2rem;
    gap: 0.5rem;
  }

  /* Monogram */
  .hero-monogram {
    width: clamp(64px, 14vw, 100px);
    height: auto;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 4px 12px rgba(201,168,76,0.35));
    animation: monogramPulse 4s ease-in-out infinite;
  }

  @keyframes monogramPulse {
    0%, 100% { filter: drop-shadow(0 4px 12px rgba(201,168,76,0.3)); }
    50%       { filter: drop-shadow(0 6px 20px rgba(201,168,76,0.55)); }
  }

  /* Top label row */
  .hero-label-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .label-line {
    width: clamp(30px, 8vw, 60px);
    height: 1px;
    background: rgba(201,168,76,0.5);
  }
  .hero-label {
    font-size: clamp(8px, 2vw, 11px);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-deep);
    opacity: 0.55;
    white-space: nowrap;
  }

  /* Name row */
  .hero-name-row {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    gap: 0.5em;
    flex-wrap: nowrap;
  }

  /* Names */
  .hero-name {
    font-size: clamp(2rem, 9vw, 4.5rem);
    color: #ffffff;
    letter-spacing: 0.15em;
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4), 0 1px 4px rgba(0,0,0,0.3);
  }

  /* Diamond separator */
  .hero-diamond {
    font-size: clamp(1rem, 3vw, 1.5rem);
    color: #ffffff;
    letter-spacing: 0.15em;
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4), 0 1px 4px rgba(0,0,0,0.3);
  }

  /* Dot divider */
  .hero-dot-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0.5rem 0;
  }
  .dot-line   { width: clamp(30px, 8vw, 60px); height: 1px; background: rgba(255,255,255,0.7); }
  .dot-center { width: 5px; height: 5px; border-radius: 50%; background: #ffffff; }

  /* Invite text */
  .hero-invite {
    font-size: clamp(2rem, 7vw, 4rem);
    color: #ffffff;
    letter-spacing: 0.15em;
    line-height: 1;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4), 0 1px 4px rgba(0,0,0,0.3);
  }

  /* Scroll cue */
  .scroll-cue {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    opacity: 0.85;
    animation: cueFade 1.5s ease 1.2s both;
  }
  .scroll-label {
    font-size: clamp(10px, 2vw, 12px);
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--color-gold);
  }
  .scroll-arrow {
    width: 24px;
    height: 24px;
    color: var(--color-gold);
    animation: bounceDown 1.8s ease-in-out infinite;
  }

  @keyframes cueFade {
    from { opacity: 0; transform: translateX(-50%) translateY(8px); }
    to   { opacity: 0.85; transform: translateX(-50%) translateY(0); }
  }
  @keyframes bounceDown {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(5px); }
  }
</style>

<script>
  import { gsap } from 'gsap';

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
  tl.from('.hero-label-row',  { opacity: 0, y: 12, duration: 0.8 })
    .from('.hero-name-row',   { opacity: 0, y: 28, duration: 1 }, '-=0.4')
    .from('.hero-dot-row',    { opacity: 0, duration: 0.5 }, '-=0.3')
    .from('.hero-invite',     { opacity: 0, y: 10, duration: 0.8 }, '-=0.3')
    .from('.corner',          { opacity: 0, scale: 0.7, stagger: 0.1, duration: 0.6 }, '-=0.8');
</script>
