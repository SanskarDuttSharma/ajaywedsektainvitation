<style>
  .couple-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.25rem;
    width: 100%;
    max-width: 300px;
    margin: 0 auto 1rem;
  }

  .char {
    flex: 0 0 auto;
    width: 136px;
  }

  .char svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  /* Floating animations */
  @keyframes brideFloat {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-10px); }
  }
  @keyframes groomFloat {
    0%, 100% { transform: translateY(-5px); }
    50%       { transform: translateY(5px); }
  }
  @keyframes dupattalWave {
    0%, 100% { transform-origin: 88px 108px; transform: rotate(0deg); }
    50%       { transform-origin: 88px 108px; transform: rotate(4deg) translateX(4px); }
  }

  .char-bride { animation: brideFloat 3.2s ease-in-out infinite; }
  .char-groom { animation: groomFloat 3.8s ease-in-out infinite; animation-delay: 0.6s; }
  .bride-dupatta { animation: dupattalWave 2.8s ease-in-out infinite; }

  /* Responsive sizing */
  @media (max-width: 400px) {
    .couple-wrap { max-width: 240px; gap: 0; }
    .char { width: 110px; }
  }
</style>
